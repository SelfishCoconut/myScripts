#!/usr/bin/env python3

import argparse
import glob
import io
import os
import shutil
import subprocess
import sys
import tempfile
from PIL import Image, ImageDraw, ImageFont, ImageOps


def create_watermark(image, text, opacity, angle, font_size, spacing, color, font_path):

    width, height = image.size

    # Load font (built-in fallback, no external font dependency)
    if font_path:
        try:
            font = ImageFont.truetype(font_path, font_size)
        except OSError:
            print("Warning: Custom font unavailable. Using built-in font.")
            font = ImageFont.load_default(size=font_size)
    else:
        font = ImageFont.load_default(size=font_size)

    # Calculate text dimensions
    bbox = font.getbbox(text)
    text_width = max(1, int(font.getlength(text)))
    text_height = max(1, bbox[3] - bbox[1])

    # Create a repeating watermark tile
    step_x = max(1, text_width + spacing)
    step_y = max(1, text_height + spacing)

    tile = Image.new(
        "RGBA",
        (step_x, step_y),
        (0, 0, 0, 0)
    )

    draw = ImageDraw.Draw(tile)

    draw.text(
        (0, 0),
        text,
        font=font,
        fill=(*color, opacity)
    )

    # Create a pattern large enough to cover the image after rotation
    diagonal = int((width ** 2 + height ** 2) ** 0.5)

    pattern = Image.new(
        "RGBA",
        (diagonal * 2, diagonal * 2),
        (0, 0, 0, 0)
    )

    for y in range(0, pattern.height, step_y):
        for x in range(0, pattern.width, step_x):
            pattern.alpha_composite(tile, (x, y))

    # Rotate the pattern
    pattern = pattern.rotate(
        angle,
        resample=Image.Resampling.BICUBIC,
        expand=False
    )

    # Crop the center to the original image dimensions
    cx = pattern.width // 2
    cy = pattern.height // 2

    pattern = pattern.crop((
        cx - width // 2,
        cy - height // 2,
        cx - width // 2 + width,
        cy - height // 2 + height
    ))

    # Composite watermark over original
    base = image.convert("RGBA")
    result = Image.alpha_composite(base, pattern)

    return result


def render_pdf(path, dpi, outdir):
    """Render every page of a PDF to PNG with poppler's pdftoppm."""
    if not shutil.which("pdftoppm"):
        raise RuntimeError("PDF support needs poppler (pdftoppm) installed.")
    result = subprocess.run(
        ["pdftoppm", "-r", str(dpi), "-png", path, os.path.join(outdir, "page")],
        capture_output=True,
        text=True
    )
    if result.returncode != 0:
        raise RuntimeError(f"pdftoppm failed: {result.stderr.strip()}")
    pages = sorted(glob.glob(os.path.join(outdir, "page*.png")))
    if not pages:
        raise RuntimeError("PDF has no pages.")
    return pages


def overlay_pdf(path, output, make_overlay, dpi):
    """Draw the watermark over each page of the original PDF.

    The pages themselves are untouched, so text stays selectable/searchable.
    """
    try:
        import pymupdf as fitz
    except ImportError:
        raise RuntimeError(
            "Keeping PDF text selectable needs PyMuPDF "
            "(Arch: sudo pacman -S python-pymupdf; or pip install pymupdf). "
            "Or pass --flatten to rasterize pages instead."
        )

    cache = {}
    with fitz.open(path) as doc:
        if doc.needs_pass:
            raise RuntimeError("PDF is password-protected.")
        for page in doc:
            # Build the overlay in the orientation the viewer sees.
            visible = page.rect
            key = (round(visible.width), round(visible.height), page.rotation)
            if key not in cache:
                px = (max(1, round(visible.width * dpi / 72)),
                      max(1, round(visible.height * dpi / 72)))
                buf = io.BytesIO()
                make_overlay(Image.new("RGBA", px, (0, 0, 0, 0))).save(buf, "PNG")
                cache[key] = buf.getvalue()
            # insert_image works in unrotated page space; undo the page rotation.
            page.insert_image(
                visible * page.derotation_matrix,
                stream=cache[key],
                rotate=page.rotation,
                overlay=True,
            )
        doc.save(output, garbage=3, deflate=True)


def atomic_output(output):
    """A temp path next to OUTPUT, so overwriting the input file is safe."""
    fd, tmp = tempfile.mkstemp(
        suffix=".pdf", prefix=".watermark-",
        dir=os.path.dirname(os.path.abspath(output))
    )
    os.close(fd)
    return tmp


def bake_pdf(path, output, watermark_page, dpi):
    """Bake the watermark into each page's pixels, then restore the text.

    Every page becomes one image, so the watermark can't be peeled off as a
    layer. The original words are re-inserted as invisible text (the way
    searchable scans work), so selecting, searching and copying still work.
    """
    try:
        import pymupdf
    except ImportError:
        raise RuntimeError(
            "This mode needs PyMuPDF (Arch: sudo pacman -S python-pymupdf; "
            "or pip install pymupdf). Or pass --flatten for an image-only PDF."
        )

    with pymupdf.open(path) as src, pymupdf.open() as out:
        if src.needs_pass:
            raise RuntimeError("PDF is password-protected.")
        for page in src:
            pix = page.get_pixmap(dpi=dpi, alpha=False)
            image = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
            buf = io.BytesIO()
            watermark_page(image).convert("RGB").save(buf, "PNG")

            visible = page.rect  # as the viewer sees it (rotation applied)
            new = out.new_page(width=visible.width, height=visible.height)
            new.insert_image(new.rect, stream=buf.getvalue())

            # Words come back in unrotated space; map them to what's displayed.
            for x0, y0, x1, y1, word, *_ in page.get_text("words"):
                box = pymupdf.Rect(x0, y0, x1, y1) * page.rotation_matrix
                height = box.height
                if not word or height <= 0 or box.width <= 0:
                    continue
                natural = pymupdf.get_text_length(word, fontname="helv", fontsize=height)
                if natural <= 0:
                    continue
                # Stretch the invisible word to span the original word's box.
                new.insert_text(
                    (box.x0, box.y1 - height * 0.22),
                    word + " ",  # trailing space keeps copied words apart
                    fontname="helv",
                    fontsize=height,
                    render_mode=3,  # invisible
                    morph=(pymupdf.Point(box.x0, box.y1 - height * 0.22),
                           pymupdf.Matrix(box.width / natural, 1)),
                )
        out.save(output, garbage=4, deflate=True)


def main():

    parser = argparse.ArgumentParser(
        description="Add repeated diagonal text watermark to an image or PDF. "
                    "By default PDFs get the watermark baked into the pixels with an "
                    "invisible text layer kept, so it can't be removed and text "
                    "stays selectable."
    )

    parser.add_argument("input", help="Input image or PDF")
    parser.add_argument("output", help="Output file (.jpg/.png/.webp, or .pdf)")
    parser.add_argument("text", help="Watermark text")

    parser.add_argument(
        "--opacity",
        type=int,
        default=75,
        help="Opacity from 0 to 255 (default: 75)"
    )

    parser.add_argument(
        "--angle",
        type=float,
        default=35,
        help="Rotation angle (default: 35)"
    )

    parser.add_argument(
        "--size",
        type=int,
        default=38,
        help="Font size (default: 38)"
    )

    parser.add_argument(
        "--spacing",
        type=int,
        default=100,
        help="Spacing between repetitions (default: 100)"
    )

    parser.add_argument(
        "--color",
        default="80,80,80",
        help="RGB color (default: 80,80,80)"
    )

    parser.add_argument(
        "--dpi",
        type=int,
        default=150,
        help="PDF watermark resolution (default: 150). --size and --spacing "
             "are in points for PDFs and scaled to this DPI"
    )

    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--overlay",
        action="store_true",
        help="PDF only: lay the watermark over the original pages instead "
             "of baking it in. Keeps everything else intact, but the "
             "watermark can be removed in a PDF editor"
    )
    mode.add_argument(
        "--flatten",
        action="store_true",
        help="PDF only: image-only pages with no text layer at all "
             "(needs pdftoppm, not PyMuPDF)"
    )

    parser.add_argument(
        "--font",
        default=None,
        help="Optional custom font file"
    )

    args = parser.parse_args()

    if not 0 <= args.opacity <= 255:
        parser.error("Opacity must be between 0 and 255.")

    if args.size <= 0 or args.spacing < 0:
        parser.error("Font size must be positive and spacing non-negative.")

    try:
        color = tuple(int(c) for c in args.color.split(","))

        if len(color) != 3 or any(c < 0 or c > 255 for c in color):
            raise ValueError()

    except ValueError:
        parser.error("Color must contain three RGB values (0-255).")

    if args.dpi <= 0:
        parser.error("DPI must be positive.")

    if not args.text.strip():
        parser.error("Watermark text cannot be empty.")

    in_ext = os.path.splitext(args.input)[1].lower()
    extension = os.path.splitext(args.output)[1].lower()
    is_pdf_in = in_ext == ".pdf"

    if extension not in (".jpg", ".jpeg", ".png", ".webp", ".pdf"):
        parser.error("Supported output formats: JPG, PNG, WEBP, PDF")

    if is_pdf_in and extension != ".pdf":
        parser.error("A PDF input must have a .pdf output.")

    # For PDFs, size/spacing are given in points; convert to pixels at --dpi.
    scale = args.dpi / 72 if is_pdf_in else 1
    size = max(1, round(args.size * scale))
    spacing = round(args.spacing * scale)

    def mark(source_path):
        with Image.open(source_path) as source:
            image = ImageOps.exif_transpose(source)
            image.load()
            return create_watermark(
                image, args.text, args.opacity, args.angle,
                size, spacing, color, args.font
            )

    tmp_out = None
    try:
        if is_pdf_in and not args.flatten and not args.overlay:
            tmp_out = atomic_output(args.output)
            bake_pdf(
                args.input, tmp_out, dpi=args.dpi,
                watermark_page=lambda image: create_watermark(
                    image, args.text, args.opacity, args.angle,
                    size, spacing, color, args.font
                )
            )
            os.replace(tmp_out, args.output)
            print(f"Watermarked file saved: {args.output}")
            return

        if is_pdf_in and args.overlay:
            tmp_out = atomic_output(args.output)
            overlay_pdf(
                args.input, tmp_out, dpi=args.dpi,
                make_overlay=lambda blank: create_watermark(
                    blank, args.text, args.opacity, args.angle,
                    size, spacing, color, args.font
                )
            )
            os.replace(tmp_out, args.output)
            print(f"Watermarked file saved: {args.output}")
            return

        with tempfile.TemporaryDirectory() as tmp:
            sources = render_pdf(args.input, args.dpi, tmp) if is_pdf_in else [args.input]
            results = [mark(src) for src in sources]

            if extension == ".pdf":
                pages = [r.convert("RGB") for r in results]
                pages[0].save(
                    args.output,
                    "PDF",
                    resolution=args.dpi if is_pdf_in else 72.0,
                    save_all=True,
                    append_images=pages[1:]
                )
            elif extension in (".jpg", ".jpeg"):
                results[0].convert("RGB").save(
                    args.output, quality=95, optimize=True
                )
            elif extension == ".png":
                results[0].save(args.output, optimize=True)
            else:
                results[0].save(args.output, quality=95)

        print(f"Watermarked file saved: {args.output}")

    except FileNotFoundError:
        print(f"Error: File not found: {args.input}")
        sys.exit(1)

    except (OSError, RuntimeError) as error:
        if tmp_out and os.path.exists(tmp_out):
            os.remove(tmp_out)
        print(f"Error: {error}")
        sys.exit(1)


if __name__ == "__main__":
    main()
